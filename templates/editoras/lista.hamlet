<div .topo>
  <div>
    <h1>Editoras
    <p .subtitulo>Casas editoriais dos livros do acervo.
  <a .botao href=@{EditoraNovaR}>Cadastrar editora
$if null editoras
  <p .vazio>Nenhuma editora cadastrada ainda.
$else
  <div .tabela>
    <table>
      <thead>
        <tr>
          <th>Nome
          <th>Cidade
          <th>
            <span .visualmente-oculto>Ações
      <tbody>
        $forall Entity eid editora <- editoras
          <tr>
            <td .titulo>#{editoraNome editora}
            <td .secundario-texto>#{maybe "—" id (editoraCidade editora)}
            <td .acoes>
              <a .acao href=@{EditoraEditarR eid}>Editar
              <form method=post action=@{EditoraExcluirR eid} onsubmit="return confirm('Excluir esta editora?')">
                <button .acao .perigo>Excluir
