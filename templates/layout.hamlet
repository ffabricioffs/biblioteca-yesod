$doctype 5
<html lang="pt-BR">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>#{pageTitle pc} | Biblioteca
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Alegreya:wght@500;700&family=Alegreya+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap">
    ^{pageHead pc}
  <body>
    <aside .lateral>
      <a .marca href=@{HomeR}>
        <svg .marca-icone viewBox="0 0 28 28" aria-hidden="true">
          <rect x="3" y="5" width="5" height="19" rx="1">
          <rect x="10" y="3" width="5" height="21" rx="1">
          <rect x="17" y="7" width="5" height="17" rx="1" transform="rotate(-12 19.5 15.5)">
        <span>Biblioteca
      <nav aria-label="Menu principal">
        <p .grupo>Acervo
        <a :secao == "livros":.ativo href=@{LivrosR}>Livros
        <a :secao == "autores":.ativo href=@{AutoresR}>Autores
        <a :secao == "editoras":.ativo href=@{EditorasR}>Editoras
        <a :secao == "categorias":.ativo href=@{CategoriasR}>Categorias
        <p .grupo>Circulação
        <a :secao == "emprestimos":.ativo href=@{EmprestimosR}>Empréstimos
        <a :secao == "leitores":.ativo href=@{LeitoresR}>Leitores
      <p .rodape>Feito com Yesod e PostgreSQL. Endereços via ViaCEP.
    <main .conteudo>
      $maybe msg <- mensagem
        #{msg}
      ^{pageBody pc}
