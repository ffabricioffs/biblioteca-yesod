<div .topo>
  <div>
    <h1>Leitores
    <p .subtitulo>#{length leitores} leitores cadastrados.
  <a .botao href=@{LeitorNovoR}>Cadastrar leitor
$if null leitores
  <p .vazio>Nenhum leitor cadastrado ainda.
$else
  <div .tabela>
    <table>
      <thead>
        <tr>
          <th>Nome
          <th>E-mail
          <th>Cidade
          <th>
            <span .visualmente-oculto>Ações
      <tbody>
        $forall Entity lid leitor <- leitores
          <tr>
            <td .titulo>
              <a href=@{LeitorR lid}>#{leitorNome leitor}
            <td .secundario-texto>#{leitorEmail leitor}
            <td>#{leitorCidade leitor}/#{leitorUf leitor}
            <td .acoes>
              <a .acao href=@{LeitorEditarR lid}>Editar
              <form method=post action=@{LeitorExcluirR lid} onsubmit="return confirm('Excluir este leitor?')">
                <button .acao .perigo>Excluir
