<div .topo>
  <h1>#{leitorNome leitor}
  <div .acoes>
    <a .botao href=@{LeitorEditarR lid}>Editar
    <form method=post action=@{LeitorExcluirR lid} onsubmit="return confirm('Excluir este leitor?')">
      <button .perigo>Excluir
<div .cartao>
  <dl>
    <dt>E-mail
    <dd>#{leitorEmail leitor}
    <dt>Telefone
    <dd>#{maybe "—" id (leitorTelefone leitor)}
    <dt>CEP
    <dd>#{leitorCep leitor}
    <dt>Endereço
    <dd>#{leitorLogradouro leitor}, #{leitorNumero leitor} – #{leitorBairro leitor}
    <dt>Cidade/UF
    <dd>#{leitorCidade leitor}/#{leitorUf leitor}
  <p>
    <small>Endereço preenchido automaticamente pela API ViaCEP.
<h2>Empréstimos
$if null historico
  <p .vazio>Nenhum empréstimo.
$else
  <table>
    <tr>
      <th>Livro
      <th>Empréstimo
      <th>Previsto
      <th>Devolução
    $forall (e, livro) <- historico
      <tr>
        <td>#{livroTitulo livro}
        <td>#{formatarData (emprestimoDataEmprestimo e)}
        <td>#{formatarData (emprestimoDataPrevista e)}
        <td>#{maybe "—" formatarData (emprestimoDataDevolucao e)}
<p>
  <a href=@{LeitoresR}>← Voltar para leitores
