<div .topo>
  <div>
    <h1>#{livroTitulo livro}
    <p .subtitulo>#{T.intercalate ", " (map autorNome autores)}
  <div .botoes>
    $if disponiveis > 0
      <a .botao href=@{EmprestimoNovoR}>Registrar empréstimo
    <a .botao .secundario href=@{LivroEditarR lid}>Editar
    <form method=post action=@{LivroExcluirR lid} onsubmit="return confirm('Excluir este livro?')">
      <button .acao .perigo>Excluir
<div .detalhe>
  <div .capa style="background-color: #{corLombada livro}" aria-hidden="true">#{livroTitulo livro}
  <div .ficha>
    <p .ficha-cabecalho>
      <span>Ficha catalográfica
      <span>Registro nº #{toPathPiece lid}
    <dl>
      <dt>Autores
      <dd>#{T.intercalate ", " (map autorNome autores)}
      <dt>Editora
      <dd>#{editoraNome editora}
      <dt>Categoria
      <dd>#{categoriaNome categoria}
      <dt>Ano
      <dd>#{maybe "—" show (livroAnoPublicacao livro)}
      <dt>ISBN
      <dd>#{maybe "—" id (livroIsbn livro)}
      <dt>Na estante
      <dd>
        $if disponiveis > 0
          #{disponiveis} de #{livroQuantidade livro} exemplares
        $else
          <span .indisponivel>Todos os #{livroQuantidade livro} exemplares estão emprestados
<section .secao>
  <h2>Histórico de empréstimos
  $if null historico
    <p .vazio>Este livro ainda não saiu da biblioteca.
  $else
    <div .tabela>
      <table>
        <thead>
          <tr>
            <th>Leitor
            <th>Saiu em
            <th>Volta até
            <th>Situação
        <tbody>
          $forall (e, leitor) <- historico
            $with (texto, classe) <- statusEmprestimo dia e
              <tr>
                <td>#{leitorNome leitor}
                <td>#{formatarData (emprestimoDataEmprestimo e)}
                <td>#{formatarData (emprestimoDataPrevista e)}
                <td>
                  <span .carimbo class=#{classe}>#{texto}
<p .voltar>
  <a href=@{LivrosR}>Voltar para o catálogo
