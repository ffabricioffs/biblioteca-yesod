<div .topo>
  <div>
    <h1>Categorias
    <p .subtitulo>Assuntos usados para organizar o acervo.
  <a .botao href=@{CategoriaNovaR}>Cadastrar categoria
$if null categorias
  <p .vazio>Nenhuma categoria cadastrada ainda.
$else
  <div .tabela>
    <table>
      <thead>
        <tr>
          <th>Nome
          <th>Descrição
          <th>
            <span .visualmente-oculto>Ações
      <tbody>
        $forall Entity cid categoria <- categorias
          <tr>
            <td .titulo>#{categoriaNome categoria}
            <td .secundario-texto>#{maybe "—" id (categoriaDescricao categoria)}
            <td .acoes>
              <a .acao href=@{CategoriaEditarR cid}>Editar
              <form method=post action=@{CategoriaExcluirR cid} onsubmit="return confirm('Excluir esta categoria?')">
                <button .acao .perigo>Excluir
