-- ============================================================
-- Modelo de dados (Persistent). Cada bloco vira uma TABELA no
-- PostgreSQL e um TIPO Haskell. O "id" (chave primária) é criado
-- automaticamente. Campos do tipo XxxId são CHAVES ESTRANGEIRAS.
-- "Maybe" = coluna que aceita NULL.
-- "UniqueXxx campo" = restrição UNIQUE no banco.
-- ============================================================

-- 1) Categoria do livro (Romance, Ficção Científica, Didático...)
Categoria
    nome      Text
    descricao Text Maybe
    UniqueCategoriaNome nome
    deriving Show Eq

-- 2) Editora que publicou o livro
Editora
    nome   Text
    cidade Text Maybe
    UniqueEditoraNome nome
    deriving Show Eq

-- 3) Autor (um livro pode ter vários autores e vice-versa)
Autor
    nome          Text
    nacionalidade Text Maybe
    deriving Show Eq

-- 4) Livro: pertence a UMA editora e a UMA categoria (N:1)
Livro
    titulo        Text
    isbn          Text Maybe
    anoPublicacao Int Maybe
    quantidade    Int              -- nº de exemplares que a biblioteca possui
    editoraId     EditoraId        -- FK -> editora.id
    categoriaId   CategoriaId      -- FK -> categoria.id
    deriving Show Eq

-- 5) Tabela associativa do relacionamento N:N entre Livro e Autor
LivroAutor
    livroId LivroId                -- FK -> livro.id
    autorId AutorId                -- FK -> autor.id
    UniqueLivroAutor livroId autorId
    deriving Show Eq

-- 6) Leitor: o endereço (logradouro, bairro, cidade, uf) é
--    preenchido automaticamente pela API ViaCEP a partir do CEP.
Leitor
    nome       Text
    email      Text
    telefone   Text Maybe
    cep        Text
    logradouro Text
    numero     Text
    bairro     Text
    cidade     Text
    uf         Text
    UniqueLeitorEmail email
    deriving Show Eq

-- 7) Empréstimo: liga um Livro a um Leitor.
--    dataDevolucao = Nothing (NULL) significa "ainda não devolvido".
Emprestimo
    livroId        LivroId         -- FK -> livro.id
    leitorId       LeitorId        -- FK -> leitor.id
    dataEmprestimo Day
    dataPrevista   Day
    dataDevolucao  Day Maybe
    deriving Show Eq
