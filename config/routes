-- ============================================================
-- Rotas da aplicação: URL   NomeDaRota   MétodosHTTP
-- Para cada rota+método o Yesod exige um handler chamado
-- <metodo><NomeDaRota>, ex.: getLivrosR, postLivroNovoR.
-- #LivroId = parâmetro da URL convertido para a chave do banco.
-- Formulários HTML só enviam GET/POST, por isso editar e excluir
-- usam POST em rotas próprias (/editar, /excluir).
-- ============================================================

/                                    HomeR              GET

/categorias                          CategoriasR        GET
/categorias/nova                     CategoriaNovaR     GET POST
/categorias/#CategoriaId/editar      CategoriaEditarR   GET POST
/categorias/#CategoriaId/excluir     CategoriaExcluirR  POST

/editoras                            EditorasR          GET
/editoras/nova                       EditoraNovaR       GET POST
/editoras/#EditoraId/editar          EditoraEditarR     GET POST
/editoras/#EditoraId/excluir         EditoraExcluirR    POST

/autores                             AutoresR           GET
/autores/novo                        AutorNovoR         GET POST
/autores/#AutorId/editar             AutorEditarR       GET POST
/autores/#AutorId/excluir            AutorExcluirR      POST

/livros                              LivrosR            GET
/livros/novo                         LivroNovoR         GET POST
/livros/#LivroId/detalhes            LivroR             GET
/livros/#LivroId/editar              LivroEditarR       GET POST
/livros/#LivroId/excluir             LivroExcluirR      POST

/leitores                            LeitoresR          GET
/leitores/novo                       LeitorNovoR        GET POST
/leitores/#LeitorId/detalhes         LeitorR            GET
/leitores/#LeitorId/editar           LeitorEditarR      GET POST
/leitores/#LeitorId/excluir          LeitorExcluirR     POST

/emprestimos                         EmprestimosR       GET
/emprestimos/novo                    EmprestimoNovoR    GET POST
/emprestimos/#EmprestimoId/editar    EmprestimoEditarR  GET POST
/emprestimos/#EmprestimoId/devolver  EmprestimoDevolverR POST
/emprestimos/#EmprestimoId/excluir   EmprestimoExcluirR POST
